# Copy to crib_remote.env (the GUI "Jev 서버" panel writes this file for you). Do not commit crib_remote.env.
# OPT-IN: Jev on Google Colab behind an https tunnel. Baby photos then leave your home network.
# Environment variables of the same names override this file. The file counts only if BACKEND=remote.
# The token is a secret: keep the file private (the GUI saves it with permissions 0600 where supported).
CRIB_JEV_BACKEND=local
# Printed by the Colab notebook. https only, no path, no user:pass@.
CRIB_JEV_URL=https://replace-with-colab-url.trycloudflare.com
CRIB_JEV_TOKEN=replace-with-colab-token
# Seconds per request (optional, remote only). Colab is ~3-6 s per photo, the first one slower.
# CRIB_JEV_TIMEOUT=180
# 1 = live monitoring (watch.py) may ALSO use the remote Jev. Default 0: live monitoring stays on the local server.
CRIB_JEV_REMOTE_LIVE=0
