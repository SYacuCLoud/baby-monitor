# Copy to crib_remote.env. Do not commit crib_remote.env.
# OPT-IN remote Jev (https web API). Default is local 127.0.0.1:8090.
# Same-named environment variables override this file. The file counts only if BACKEND=remote.
CRIB_JEV_BACKEND=local
# CRIB_JEV_URL=https://example.example/v1/systemone
# CRIB_JEV_TOKEN=replace-with-token
# CRIB_JEV_TIMEOUT=180
# 1 = live monitoring (watch.py) may ALSO use the remote Jev. Default 0: local only.
CRIB_JEV_REMOTE_LIVE=0
